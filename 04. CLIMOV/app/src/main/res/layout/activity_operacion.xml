<?xml version="1.0" encoding="utf-8"?>
<!-- Depósito, retiro y transferencia -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/cabecera" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTipoDeposito"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Depósito"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTipoRetiro"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Retiro"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTipoTransferencia"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Transferir"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tarjetaFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lblCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuenta"
                    android:textColor="@color/tenue"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spnCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/campo"
                    android:popupBackground="@color/panel2" />

                <TextView
                    android:id="@+id/lblSaldoDisponible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/cian"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lblDestino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cuenta destino"
                    android:textColor="@color/tenue"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spnDestino"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/campo"
                    android:popupBackground="@color/panel2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Importe"
                    android:textColor="@color/tenue"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/txtImporte"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/campo"
                    android:hint="Ej. 150.50"
                    android:inputType="numberDecimal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/texto"
                    android:textColorHint="@color/tenue"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProcesar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="Procesar"
                    android:textColor="@color/oscuro"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Comprobante -->
            <LinearLayout
                android:id="@+id/tarjetaComprobante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/tarjeta"
                android:gravity="center"
                android:minHeight="130dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/lblTituloComprobante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comprobante"
                    android:textColor="@color/tenue"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/lblNuevoSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="@color/texto"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Elija la cuenta, ingrese el importe y procese."
                    android:textColor="@color/tenue"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
